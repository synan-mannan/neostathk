# ==============================================================================
# NeoStats Hackathon - Environment Configuration Template
# ==============================================================================

# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development
# Port on which the Express server listens
PORT=4000
# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000
# PostgreSQL connection string (connects to local postgres instance)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/neostats_hackathon

# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
# Base URL for backend REST API calls (accessible to browser runtime)
NEXT_PUBLIC_API_URL=http://localhost:4000
